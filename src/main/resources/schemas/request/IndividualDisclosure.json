{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "classpath:/schemas/request/IndividualDisclosure.json",
  "type": "object",
  "properties": {
    "birthDate": {
      "description": "Format: yyyy-MM-dd",
      "format": "date",
      "type": "string"
    },
    "firstName": {
      "type": "string",
      "minLength": 1
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Unknown"
      ]
    },
    "lastName": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "firstName",
    "gender",
    "lastName"
  ],
  "additionalProperties": false
}
